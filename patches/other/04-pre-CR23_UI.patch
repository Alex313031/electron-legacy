@@ -37,7 +37,33 @@ SubmenuButton::SubmenuButton(PressedCallback callback,
   ink_drop->SetMode(views::InkDropHost::InkDropMode::ON);
   ink_drop->SetBaseColor(
       color_utils::BlendTowardMaxContrast(background_color_, 0x81));
-  views::InkDrop::UseInkDropForFloodFillRipple(ink_drop, false, true);
+
+  // Square, like the menu this button opens.
+  //
+  // MenuButton inherits LabelButton's focus ring radii, which default to
+  // FocusRing::kDefaultCornerRadiusDp (2dp), and LabelButton feeds those to
+  // both the ink drop's corner radii and its highlight path. 2dp is a
+  // Chrome-Refresh-2023 shape, and it sits badly against the menus this opens:
+  // patches/other/04 maps kMenuRadius to Emphasis::kNone, so the dropdown has
+  // square corners while the thing that summoned it had rounded ones.
+  //
+  // Setting the radii to zero covers both, since LabelButton reinstalls the
+  // highlight path generator from them.
+  SetFocusRingCornerRadii(gfx::RoundedCornersF(0));
+
+  // Pre-Refresh weight, rather than Refresh's. InkDropHighlight defaults to
+  // 0.128 visible opacity, which over a menu bar background is faint enough to
+  // read as a tint rather than a selection -- the "lighter" look. Menu bars
+  // predate the Refresh design language and are drawn flat here, so the
+  // highlight has to carry the whole affordance by itself.
+  ink_drop->SetHighlightOpacity(0.24f);
+
+  // Highlight on hover, not only while the ripple runs. Upstream Electron
+  // passes false here, which leaves a hover with nothing to show for it on a
+  // flat menu bar: the only feedback is the press ripple, by which point the
+  // menu is already open.
+  views::InkDrop::UseInkDropForFloodFillRipple(ink_drop, /*highlight_on_hover=*/true,
+                                               /*highlight_on_focus=*/true);
 }
 
 SubmenuButton::~SubmenuButton() = default;
