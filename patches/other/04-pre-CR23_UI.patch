+void MenuBar::UpdateNativeBackground() {
+  static const bool native_colors =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("native-colors");
+  const ui::ColorProvider* color_provider = root_view_->GetColorProvider();
+  if (!native_colors || !color_provider)
+    return;
+
+  BOOL flat_menus = FALSE;
+  ::SystemParametersInfo(SPI_GETFLATMENU, 0, &flat_menus, 0);
+  if (flat_menus && color_provider->GetColor(ui::kColorMenuBackground) ==
+                        GetSysSkColor(COLOR_MENU)) {
+    SetBackground(
+        views::CreateSolidBackground(GetSysSkColor(COLOR_MENUBAR)));
+  } else {
+    SetBackground(views::CreateSolidBackground(ui::kColorMenuBackground));
+  }
+}
+#endif
