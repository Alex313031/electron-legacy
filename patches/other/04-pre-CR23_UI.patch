diff --git a/ui/color/win/native_color_mixers_win.cc b/ui/color/win/native_color_mixers_win.cc
--- a/ui/color/win/native_color_mixers_win.cc
+++ b/ui/color/win/native_color_mixers_win.cc
@@ -133,9 +133,60 @@
   }
 }
 
+namespace {
+
+// With this switch the menus and tooltips take the user's Windows colors.
+// Without it they keep Chromium's own, which in this tree are the ones from
+// before Chrome Refresh 2023: see AddColorMixers() in ui/color/color_mixers.cc.
+constexpr char kNativeColorsSwitch[] = "native-colors";
+
+// --native-colors: what the user's Windows theme says a menu and a tooltip
+// look like, read from the system colors.
+//
+// Only for a light application. Windows has no dark set of these, so a dark
+// one keeps Chromium's colors rather than getting a light menu on a dark
+// window.
+void AddNativeMenuColorMixer(ColorProvider* provider,
+                             const ColorProviderKey& key) {
+  if (key.color_mode == ColorProviderKey::ColorMode::kDark ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch(kNativeColorsSwitch)) {
+    return;
+  }
+  ColorMixer& mixer = provider->AddMixer();
+
+  const auto sys_color = [](int color) {
+    return skia::COLORREFToSkColor(::GetSysColor(color));
+  };
+  // With flat menus, which is the Windows XP style and everything since, the
+  // selected item is COLOR_MENUHILIGHT. Without, the classic 3D menu, it is
+  // the same COLOR_HIGHLIGHT as a selection anywhere else.
+  BOOL flat_menus = FALSE;
+  ::SystemParametersInfo(SPI_GETFLATMENU, 0, &flat_menus, 0);
+  const SkColor menu_text = sys_color(COLOR_MENUTEXT);
+  const SkColor selection =
+      sys_color(flat_menus ? COLOR_MENUHILIGHT : COLOR_HIGHLIGHT);
+
+  mixer[kColorMenuBackground] = {sys_color(COLOR_MENU)};
+  mixer[kColorMenuBorder] = {kColorNativeBtnShadow};
+  mixer[kColorMenuSeparator] = {kColorNativeBtnShadow};
+  mixer[kColorMenuDropmarker] = {menu_text};
+  mixer[kColorMenuIcon] = {menu_text};
+  mixer[kColorMenuItemForeground] = {menu_text};
+  mixer[kColorMenuItemForegroundSecondary] = {menu_text};
+  mixer[kColorMenuItemForegroundDisabled] = {kColorNativeGrayText};
+  mixer[kColorMenuItemBackgroundSelected] = {selection};
+  mixer[kColorMenuSelectionBackground] = {selection};
+  mixer[kColorMenuItemForegroundSelected] = {kColorNativeHighlightText};
+  mixer[kColorTooltipBackground] = {sys_color(COLOR_INFOBK)};
+  mixer[kColorTooltipForeground] = {sys_color(COLOR_INFOTEXT)};
+}
+
+}  // namespace
+
 void AddNativeUiColorMixer(ColorProvider* provider,
                            const ColorProviderKey& key) {
   if (key.contrast_mode == ColorProviderKey::ContrastMode::kNormal) {
+    AddNativeMenuColorMixer(provider, key);
     return;
   }
 
