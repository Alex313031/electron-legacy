diff --git a/ui/views/layout/layout_provider.cc b/ui/views/layout/layout_provider.cc
index d243aa338748a..7fd9d2acd306b 100644
--- a/ui/views/layout/layout_provider.cc
+++ b/ui/views/layout/layout_provider.cc
@@ -226,6 +226,43 @@ ShapeSysTokens GetShapeSysToken(ShapeContextTokens id) {
 
 int LayoutProvider::GetCornerRadiusMetric(ShapeContextTokens id,
                                           const gfx::Size& size) const {
+  // Pre-Chrome-Refresh-2023 corner radii. Upstream routes every token through
+  // GetShapeSysToken() below, which bottoms out at 8-24px for most of them;
+  // these are the smaller pre-Refresh values.
+  //
+  // Not exhaustive over ShapeContextTokens on purpose. Anything unlisted falls
+  // through to upstream's mapping, so a token added by a future Chromium roll
+  // keeps working -- where Thorium's switch is exhaustive and would reach its
+  // NOTREACHED instead.
+  switch (id) {
+    case ShapeContextTokens::kMenuRadius:
+    case ShapeContextTokens::kMenuAuxRadius:
+      // Square menus, which is the point of this patch. Upstream gives these
+      // kMediumSmall, i.e. 12px. Overridden here rather than in the token map
+      // because that map has no "no radius" token: kDefault means "missing
+      // mapping" and trips the DCHECK below.
+      return GetCornerRadiusMetric(Emphasis::kNone);
+    case ShapeContextTokens::kMenuTouchRadius:
+      // Still rounded for touch, just less than upstream's 12px.
+      return GetCornerRadiusMetric(Emphasis::kHigh);
+    case ShapeContextTokens::kBadgeRadius:
+      return 3;
+    case ShapeContextTokens::kTextfieldRadius:
+      return 4;
+    case ShapeContextTokens::kContentSeparatorRadius:
+      return 8;
+    case ShapeContextTokens::kOmniboxExpandedRadius:
+      return 16;
+    case ShapeContextTokens::kButtonRadius:
+    case ShapeContextTokens::kComboboxRadius:
+    case ShapeContextTokens::kDialogRadius:
+    case ShapeContextTokens::kExtensionsMenuButtonRadius:
+    case ShapeContextTokens::kFindBarViewRadius:
+      return GetCornerRadiusMetric(Emphasis::kMedium, size);
+    default:
+      break;
+  }
+
   ShapeSysTokens token = GetShapeSysToken(id);
   DCHECK_NE(token, ShapeSysTokens::kDefault)
       << "kDefault token means there is a missing mapping between shape tokens";
