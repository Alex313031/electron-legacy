diff --git a/ui/views/layout/layout_provider.cc b/ui/views/layout/layout_provider.cc
index d243aa338748a..5b98869d1e03f 100644
--- a/ui/views/layout/layout_provider.cc
+++ b/ui/views/layout/layout_provider.cc
@@ -226,6 +226,16 @@ ShapeSysTokens GetShapeSysToken(ShapeContextTokens id) {
 
 int LayoutProvider::GetCornerRadiusMetric(ShapeContextTokens id,
                                           const gfx::Size& size) const {
+  // Pre-Chrome-Refresh-2023: menus are square. Upstream maps both of these to
+  // kMediumSmall, i.e. a 12px radius, which is the look this build exists to
+  // avoid on Windows. Done here rather than in the token map because that has
+  // no token for "no radius" -- kDefault means "missing mapping" and trips the
+  // DCHECK below. kMenuTouchRadius is left rounded, as touch menus should be.
+  if (id == ShapeContextTokens::kMenuRadius ||
+      id == ShapeContextTokens::kMenuAuxRadius) {
+    return 0;
+  }
+
   ShapeSysTokens token = GetShapeSysToken(id);
   DCHECK_NE(token, ShapeSysTokens::kDefault)
       << "kDefault token means there is a missing mapping between shape tokens";
