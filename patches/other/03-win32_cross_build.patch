+// Everywhere else the platform provides these, so forward to them and keep the
+// call sites below identical on all platforms.
+static const char* win32_inet_ntop(int af, const void* src, char* dst,
+                                   socklen_t size) {
+  return inet_ntop(af, src, dst, size);
+}
+
+static int win32_inet_pton(int af, const char* src, void* dst) {
+  return inet_pton(af, src, dst);
+}
