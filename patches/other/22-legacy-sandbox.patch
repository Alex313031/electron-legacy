diff --git a/sandbox/policy/sandbox_type.cc b/sandbox/policy/sandbox_type.cc
index 1b87649d48..d5d3e23175 100644
--- a/sandbox/policy/sandbox_type.cc
+++ b/sandbox/policy/sandbox_type.cc
@@ -192,15 +192,34 @@ sandbox::mojom::Sandbox SandboxTypeFromCommandLine(
   if (process_type.empty())
     return Sandbox::kNoSandbox;
 
-  if (process_type == switches::kRendererProcess)
+#if BUILDFLAG(IS_WIN)
+  // --legacy-sandbox drops the sandbox for exactly the three child types that
+  // have one of their own on Windows. Opt-in only, and deliberately not gated
+  // on a Windows version: Supermium, which this follows, disables the utility
+  // sandbox for everything below Win10 outright, but XP through 8.1 are
+  // currently sandboxing correctly here, and turning that off for all of them
+  // to buy insurance against a failure we have not seen would be a straight
+  // loss. The flag is here so that if one of them does turn out to be flaky,
+  // the answer is a command-line argument rather than a rebuild.
+  const bool legacy_sandbox = command_line.HasSwitch(switches::kLegacySandbox);
+#else
+  const bool legacy_sandbox = false;
+#endif
+
+  if (process_type == switches::kRendererProcess) {
+    if (legacy_sandbox)
+      return Sandbox::kNoSandbox;
     return Sandbox::kRenderer;
+  }
 
   if (process_type == switches::kUtilityProcess) {
+    if (legacy_sandbox)
+      return Sandbox::kNoSandbox;
     return UtilitySandboxTypeFromString(
         command_line.GetSwitchValueASCII(switches::kServiceSandboxType));
   }
   if (process_type == switches::kGpuProcess) {
-    if (command_line.HasSwitch(switches::kDisableGpuSandbox))
+    if (command_line.HasSwitch(switches::kDisableGpuSandbox) || legacy_sandbox)
       return Sandbox::kNoSandbox;
     return Sandbox::kGpu;
   }
