diff --git a/sandbox/win/src/interception.cc b/sandbox/win/src/interception.cc
index d074722947..40329e81fa 100644
--- a/sandbox/win/src/interception.cc
+++ b/sandbox/win/src/interception.cc
@@ -389,12 +391,61 @@ InterceptionManager::PatchClientFunctions(DllInterceptionData* thunks,
   if (!ntdll_base)
     return base::unexpected(SBOX_ERROR_NO_HANDLE);
 
+  if (base::win::GetVersion() <= base::win::Version::VISTA) {
+    Wow64 WowHelper(&child_.get(), ntdll_base);
+    if (!WowHelper.WaitForNtdll())
+      return base::unexpected(SBOX_ERROR_NO_HANDLE);
+  }
+
   PatchClientResultData patch;
   patch.dll_data.data_bytes = thunk_bytes;
   patch.dll_data.num_thunks = 0;
   patch.dll_data.used_bytes = offsetof(DllInterceptionData, thunks);
 
-  ServiceResolverThunk thunk(child_->Process(), /*relaxed=*/true);
+  std::unique_ptr<ServiceResolverThunk> thunk;
+#if defined(_WIN64)
+  thunk = std::make_unique<ServiceResolverThunk>(child_->Process(), true);
+#else
+  base::win::OSInfo* os_info = base::win::OSInfo::GetInstance();
+  base::win::Version real_os_version = os_info->Kernel32Version();
+  if (os_info->IsWowX86OnAMD64()) {
+    if (real_os_version >= base::win::Version::WIN10)
+      thunk.reset(new Wow64W10ResolverThunk(child_->Process(), true));
+    else if (real_os_version >= base::win::Version::WIN8)
+      thunk.reset(new Wow64W8ResolverThunk(child_->Process(), true));
+    else {
+      thunk.reset(new Wow64ResolverThunk(child_->Process(), true));
+      // A 32-bit child on 64-bit XP, Vista or 7 can reach this point before
+      // its ntdll is fully readable, and every ReadProcessMemory against it
+      // fails with ERROR_PARTIAL_COPY until it is -- taking the thunk setup
+      // below down with it. Waiting for the first read to land is enough; the
+      // value is a probe and is not used.
+      //
+      // Bounded, unlike the Supermium version this follows, which spins
+      // without a limit. This runs on the browser's process-launcher thread,
+      // so spinning forever would stall every later child launch rather than
+      // failing this one. Giving up just leaves Setup() to report a real
+      // error, which is the behaviour without this loop at all.
+      DWORD probe = 0;
+      SIZE_T bytes_read = 0;
+      constexpr int kMaxAttempts = 100;  // ~1s, 10ms apart.
+      for (int i = 0; i < kMaxAttempts; ++i) {
+        if (::ReadProcessMemory(child_->Process(), ntdll_base, &probe,
+                                sizeof(probe), &bytes_read)) {
+          break;
+        }
+        if (::GetLastError() != ERROR_PARTIAL_COPY) {
+          break;
+        }
+        ::Sleep(10);
+      }
+    }
+  } else if (real_os_version >= base::win::Version::WIN8) {
+    thunk.reset(new Win8ResolverThunk(child_->Process(), true));
+  } else {
+    thunk.reset(new ServiceResolverThunk(child_->Process(), true));
+  }
+#endif
 
   patch.originals = {};
   for (const auto& interception : interceptions_) {
