+#if BUILDFLAG(ENABLE_WIDEVINE)
+std::unique_ptr<media::KeySystemSupportRegistration>
+RendererClientBase::GetSupportedKeySystems(content::RenderFrame* render_frame,
+                                           media::GetSupportedKeySystemsCB cb) {
+  // Without this the key system the browser registered is never reported to
+  // Blink, and requestMediaKeySystemAccess('com.widevine.alpha') rejects even
+  // though a CDM was found. Chrome reaches the same call through
+  // GetChromeKeySystems(); the only thing that wrapper adds is passing
+  // can_persist_data=false for incognito profiles, and nothing but
+  // persistent-license support reads that -- which the CDM registered here
+  // does not advertise.
+  return cdm::GetSupportedKeySystemsUpdates(
+      render_frame, /*can_persist_data=*/true, std::move(cb));
+}
+#endif  // BUILDFLAG(ENABLE_WIDEVINE)
