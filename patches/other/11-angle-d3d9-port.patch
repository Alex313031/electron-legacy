+angle::Result Image9::initializeContents(const gl::Context *context)
+{
+    // 3D textures are not supported by the D3D9 backend.
+    ASSERT(mDepth == 1);
+
+    Context9 *context9 = GetImplAs<Context9>(context);
+
+    RECT lockRect = {0, 0, mWidth, mHeight};
+    D3DLOCKED_RECT locked;
+    ANGLE_TRY(lock(context9, &locked, lockRect));
+
+    const d3d9::TextureFormat &d3dFormatInfo = d3d9::GetTextureFormatInfo(mInternalFormat);
+    if (d3dFormatInfo.dataInitializerFunction != nullptr)
+    {
+        d3dFormatInfo.dataInitializerFunction(mWidth, mHeight, mDepth,
+                                              static_cast<uint8_t *>(locked.pBits), locked.Pitch,
+                                              0);
+    }
+    else
+    {
+        // Only a handful of internal formats have an initializer (the ones whose
+        // storage has to spell out an opaque alpha); everything else just wants
+        // zeroes. Zeroing a whole pitch per row avoids per-format size maths, and
+        // the pitch is this surface's own row stride, so all of it is ours to
+        // write. Compressed formats store a block row at a time, hence the
+        // division.
+        const gl::InternalFormat &glFormatInfo = gl::GetSizedInternalFormatInfo(mInternalFormat);
+        const GLuint blockHeight =
+            glFormatInfo.compressed ? glFormatInfo.compressedBlockHeight : 1u;
+        const GLuint rows = (mHeight + blockHeight - 1) / blockHeight;
+
+        // The locked rows are contiguous at Pitch stride, so one memset covers
+        // them without any pointer arithmetic of our own.
+        memset(locked.pBits, 0, static_cast<size_t>(rows) * locked.Pitch);
+    }
+
+    unlock();
+
+    return angle::Result::Continue;
+}
