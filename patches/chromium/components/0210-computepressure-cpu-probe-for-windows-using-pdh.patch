diff --git a/components/system_cpu/cpu_probe_win.cc b/components/system_cpu/cpu_probe_win.cc
index 1a11bf5c4c3e5..4ae73eec4a313 100644
--- a/components/system_cpu/cpu_probe_win.cc
+++ b/components/system_cpu/cpu_probe_win.cc
@@ -77,6 +77,25 @@ std::optional<CpuSample> CpuProbeWin::BlockingTaskRunnerHelper::Update() {
 
   PDH_STATUS pdh_status;
 
+typedef PDH_STATUS ( __stdcall * PdhAddEnglishCounterW_type) (
+  __in  PDH_HQUERY hQuery,
+  __in  LPCWSTR szFullCounterPath,
+  __in  DWORD_PTR dwUserData,
+  __out PDH_HCOUNTER * phCounter
+  );
+  PdhAddEnglishCounterW_type m_pfnPdhAddEnglishCounterW = NULL;
+  HMODULE m_hinstancePDH_DLL =
