+    ::LoadLibraryW( L"pdh.dll" //LPCSTR / char *
+      );
+  if( m_hinstancePDH_DLL )
+  {
+    m_pfnPdhAddEnglishCounterW = (PdhAddEnglishCounterW_type)
+      ::GetProcAddress(m_hinstancePDH_DLL, "PdhAddEnglishCounterW" );
+    if( m_pfnPdhAddEnglishCounterW == NULL )
+      m_pfnPdhAddEnglishCounterW = (PdhAddEnglishCounterW_type)
+      ::GetProcAddress(m_hinstancePDH_DLL, "PdhAddCounterW" );
+  }
   if (!cpu_query_.is_valid()) {
     cpu_query_ = base::win::ScopedPdhQuery::Create();
     if (!cpu_query_.is_valid()) {
@@ -92,7 +111,7 @@ std::optional<CpuSample> CpuProbeWin::BlockingTaskRunnerHelper::Update() {
     const auto* query_info = is_running_in_vm
