Title: Do not read OnLinkPrefixLength where the structure has none
Origin: electron-legacy (this repo)

os.networkInterfaces() on Windows XP returned this for the first adapter:

  ????????????onnection

which is "Local Area Connection" with its first twelve bytes overwritten by
0xff. It varied from run to run; an earlier one was intact.

uv_interface_addresses() takes each address's prefix length from
IP_ADAPTER_UNICAST_ADDRESS_LH::OnLinkPrefixLength. That field is Vista's. XP
fills in the older, shorter IP_ADAPTER_UNICAST_ADDRESS_XP, so the cast reads
one byte past the end of what was written -- whatever happens to be there --
and the result is used, unchecked, as the length of a memset over the sixteen
bytes of an IPv6 netmask. A stray 255 writes thirty-two. The excess lands in
the next array element, or after the last element in the block of interface
names that follows the array in the same allocation, or, if the names are
short, past the end of the allocation. So this is a heap overflow that
happened to surface as a spoiled string, and the netmasks it reported were
never right either.

Two changes. The structure carries its own Length, so the field is read only
when the structure is long enough to contain it -- a question put to the data
rather than to the Windows version. And when it is not there, the length is
worked out from what an older Windows does provide, in uv__prefix_len_from_list():

  - for IPv4, the IP address table (GetIpAddrTable), which has a row for
    every address with its mask written out;
  - otherwise the adapter's prefix list, taking the longest prefix that
    contains the address without being the address itself. XP returns that
    list only on request, hence GAA_FLAG_INCLUDE_PREFIX, which later Windows
    behave as though were always set;
  - failing both, /64 for an IPv6 link-local address and the full length of
    the address for anything else.

The table comes first because the list turned out not to be enough by itself.
The first version of this patch used only the list, and on Server 2003 x64
reported 127.0.0.1 as /32: that system gives the loopback adapter no subnet
prefix at all. The table says 255.0.0.0, as it should.

Whatever its source, the length is then clamped to the size of the address
before it is used as one.

For both builds.

diff --git a/deps/uv/src/win/util.c b/deps/uv/src/win/util.c
--- a/deps/uv/src/win/util.c
+++ b/deps/uv/src/win/util.c
@@ -715,6 +715,150 @@
 }
 
 
+/* Whether the first `bits` bits of two addresses are the same. */
+static int uv__same_prefix(const unsigned char* a,
+                           const unsigned char* b,
+                           ULONG bits) {
+  ULONG bytes;
+  unsigned char mask;
+
+  bytes = bits >> 3;
+  if (memcmp(a, b, bytes) != 0)
+    return 0;
+  if (bits % 8 == 0)
+    return 1;
+  mask = (unsigned char) (0xff << (8 - bits % 8));
+  return (a[bytes] & mask) == (b[bytes] & mask);
+}
+
+
+/* The netmask of one of this machine's IPv4 addresses, as a prefix length,
+ * from the IP address table. 0 if the table has no such address.
+ *
+ * GetIpAddrTable is the oldest of the interfaces that could answer this and
+ * the only one that simply states it: one row per IPv4 address, loopback
+ * included, each with its mask. It is IPv4 only, which is why it is the first
+ * thing uv__prefix_len_from_list() tries and not the only thing.
+ */
+static ULONG uv__prefix_len_from_ip_table(const struct sockaddr_in* sin) {
+  MIB_IPADDRTABLE* table;
+  ULONG size;
+  ULONG prefix_len;
+  DWORD i;
+
+  size = 0;
+  if (GetIpAddrTable(NULL, &size, FALSE) != ERROR_INSUFFICIENT_BUFFER ||
+      size == 0)
+    return 0;
+  table = uv__malloc(size);
+  if (table == NULL)
+    return 0;
+
+  prefix_len = 0;
+  if (GetIpAddrTable(table, &size, FALSE) == NO_ERROR) {
+    for (i = 0; i < table->dwNumEntries; i++) {
+      ULONG mask;
+
+      if (table->table[i].dwAddr != sin->sin_addr.s_addr)
+        continue;
+      /* Count the mask's leading ones. A mask of zero is left as "unknown":
+       * no interface address really has one. */
+      for (mask = ntohl(table->table[i].dwMask);
+           mask & 0x80000000u;
+           mask <<= 1)
+        prefix_len++;
+      break;
+    }
+  }
+
+  uv__free(table);
+  return prefix_len;
+}
+
+
+/* The on-link prefix length of one of an adapter's unicast addresses, for a
+ * Windows whose IP_ADAPTER_UNICAST_ADDRESS does not say.
+ *
+ * OnLinkPrefixLength was added to that structure in Vista. On XP the
+ * structure simply ends sooner, and the same information is in the adapter's
+ * prefix list instead, in a less convenient form: one entry for the subnet,
+ * and others for the host address itself, the broadcast address and the
+ * multicast range. The subnet is the longest of them that contains the
+ * address without being the address, so that is what is looked for.
+ *
+ * The list is not complete, though. Server 2003 gives the loopback adapter no
+ * subnet entry at all, so going by the list alone 127.0.0.1 came out as /32
+ * where every other Windows says /8. An IPv4 address is therefore looked up
+ * in the IP address table first, which states its mask outright, and the list
+ * is what is left for IPv6 and for an IPv4 address the table does not have.
+ *
+ * With neither, an IPv6 link-local address is /64, which is what link-local
+ * means, and anything else is the host itself: /128 or /32, which for ::1 is
+ * simply correct.
+ */
+static ULONG uv__prefix_len_from_list(const IP_ADAPTER_ADDRESSES* adapter,
+                                      const struct sockaddr* sa) {
+  const IP_ADAPTER_PREFIX* prefix;
+  const unsigned char* address;
+  ULONG max_len;
+  ULONG best;
+
+  if (sa->sa_family == AF_INET6) {
+    address = (const unsigned char*) &((const struct sockaddr_in6*) sa)->sin6_addr;
+    max_len = 128;
+  } else {
+    ULONG from_table;
+
+    address = (const unsigned char*) &((const struct sockaddr_in*) sa)->sin_addr;
+    max_len = 32;
+
+    from_table = uv__prefix_len_from_ip_table((const struct sockaddr_in*) sa);
+    if (from_table != 0)
+      return from_table;
+  }
+
+  best = 0;
+
+  /* The list itself arrived with XP SP1; before that there is nothing to
+   * walk, and the defaults below are the answer. */
+  if (adapter->Length >= FIELD_OFFSET(IP_ADAPTER_ADDRESSES, FirstPrefix) +
+                         sizeof(adapter->FirstPrefix))
+    prefix = adapter->FirstPrefix;
+  else
+    prefix = NULL;
+
+  for (; prefix != NULL; prefix = prefix->Next) {
+    const struct sockaddr* psa = prefix->Address.lpSockaddr;
+    const unsigned char* network;
+
+    if (psa == NULL || psa->sa_family != sa->sa_family)
+      continue;
+    if (prefix->PrefixLength == 0 || prefix->PrefixLength >= max_len)
+      continue;
+    if (prefix->PrefixLength <= best)
+      continue;
+
+    if (psa->sa_family == AF_INET6)
+      network = (const unsigned char*) &((const struct sockaddr_in6*) psa)->sin6_addr;
+    else
+      network = (const unsigned char*) &((const struct sockaddr_in*) psa)->sin_addr;
+
+    if (uv__same_prefix(address, network, prefix->PrefixLength))
+      best = prefix->PrefixLength;
+  }
+
+  if (best != 0)
+    return best;
+
+  /* fe80::/10. */
+  if (sa->sa_family == AF_INET6 && address[0] == 0xfe &&
+      (address[1] & 0xc0) == 0x80)
+    return 64;
+
+  return max_len;
+}
+
+
 int uv_interface_addresses(uv_interface_address_t** addresses_ptr,
     int* count_ptr) {
   IP_ADAPTER_ADDRESSES* win_address_buf;
@@ -732,8 +876,10 @@
   *addresses_ptr = NULL;
   *count_ptr = 0;
 
+  /* GAA_FLAG_INCLUDE_PREFIX for uv__prefix_len_from_list(): XP returns the
+   * prefix list only when asked. Vista and later return it regardless. */
   flags = GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST |
-    GAA_FLAG_SKIP_DNS_SERVER;
+    GAA_FLAG_SKIP_DNS_SERVER | GAA_FLAG_INCLUDE_PREFIX;
 
   /* Fetch the size of the adapters reported by windows, and then get the list
    * itself. */
@@ -878,11 +1024,32 @@
          unicast_address = unicast_address->Next) {
       struct sockaddr* sa;
       ULONG prefix_len;
+      ULONG max_prefix_len;
 
       sa = unicast_address->Address.lpSockaddr;
 
-      prefix_len =
-        ((IP_ADAPTER_UNICAST_ADDRESS_LH*) unicast_address)->OnLinkPrefixLength;
+      /* OnLinkPrefixLength is Vista's. The structure states its own size, so
+       * ask it whether the field is there rather than asking which Windows
+       * this is. On XP it is not, and reading it anyway reads whatever follows
+       * the structure -- which then went, unchecked, into the memset below
+       * as a byte count, writing up to twelve bytes of 0xff past the end of
+       * the netmask: into the next element, or after the last one into the
+       * interface names, or with short enough names off the end of the
+       * allocation. It showed as an interface called "????????????onnection". */
+      if (unicast_address->Length >=
+          FIELD_OFFSET(IP_ADAPTER_UNICAST_ADDRESS_LH, OnLinkPrefixLength) +
+              sizeof(UINT8)) {
+        prefix_len =
+          ((IP_ADAPTER_UNICAST_ADDRESS_LH*) unicast_address)->OnLinkPrefixLength;
+      } else {
+        prefix_len = uv__prefix_len_from_list(adapter, sa);
+      }
+
+      /* And never more bits than the address has, wherever the number came
+       * from, since it is about to be used as a length. */
+      max_prefix_len = (sa->sa_family == AF_INET6) ? 128 : 32;
+      if (prefix_len > max_prefix_len)
+        prefix_len = max_prefix_len;
 
       memset(uv_address, 0, sizeof *uv_address);
 
